# ---------------------------------------------------------------------------
# LifeOS environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma (app + migrations).
# Local docker compose default:
DATABASE_URL="postgresql://lifeos:lifeos@localhost:5432/lifeos?schema=public"

# Separate database used by `npm run test:e2e`. Must NOT point at your dev data:
# the E2E suite truncates tables between runs.
TEST_DATABASE_URL="postgresql://lifeos:lifeos@localhost:5432/lifeos_test?schema=public"

# Secret used to sign session cookies and auth tokens.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-32-byte-random-string"

# Canonical origin of the deployment. Used for cookie + redirect handling.
BETTER_AUTH_URL="http://localhost:3000"

# Public base URL exposed to the browser (same value as BETTER_AUTH_URL locally).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Credentials consumed by docker-compose for the bundled PostgreSQL container.
POSTGRES_USER="lifeos"
POSTGRES_PASSWORD="lifeos"
POSTGRES_DB="lifeos"

# Test-only. The Playwright config sets this for its own server so the E2E suite
# can register an account per test. Leave it unset everywhere else: it disables
# rate limiting on the sign-in and sign-up endpoints.
# AUTH_RATE_LIMIT_DISABLED="true"

# Demo account created by `npm run db:seed` (used by the landing page hint).
SEED_DEMO_EMAIL="demo@lifeos.app"
SEED_DEMO_PASSWORD="demo-password-123"
